extends ../layouts/default.pug
include ../mixins/product-item-2.pug
include ../mixins/blog-item.pug

block main
  section.home_phone_banner.mt_25
    .container-fluid.px-lg-4.px-3
      .row.g-4
        .col-xl-8.col-lg-7
          .phone_banner_main.wow.fadeInLeft
            .phone_banner_slides(data-home-banner)
              .phone_banner_slide.active(data-banner-slide)
                .phone_banner_content
                  h4 Thời đại công nghệ mới
                  h1
                    | Nơi phong cách được
                    br
                    | Thể Hiện
                  a.common_btn(href="/product/category")
                    | Mua Ngay
                    i.far.fa-arrow-right
                .phone_banner_visual
                  img.phone_banner_phone.phone_banner_phone_back(
                    alt="Dien thoai thong minh"
                    src="/client/assets/images/product_23.jpg"
                    )
                  img.phone_banner_phone.phone_banner_phone_front(
                    alt="Dien thoai noi bat"
                    src="/client/assets/images/product_24.webp"
                    )
              .phone_banner_slide(data-banner-slide)
                .phone_banner_content
                  h4 Xu Hướng Smartphone
                  h1
                    | Chuyển Động Mượt Mà
                  a.common_btn(href="/product/category")
                    | Khám Phá Ngay
                    i.far.fa-arrow-right
                .phone_banner_visual
                  img.phone_banner_phone.phone_banner_phone_back(
                    alt="Dien thoai cao cap"
                    src="/client/assets/images/product_24.webp"
                    )
                  img.phone_banner_phone.phone_banner_phone_front(
                    alt="Dien thoai moi nhat"
                    src="/client/assets/images/product_25.webp"
                    )
              .phone_banner_slide(data-banner-slide)
                .phone_banner_content
                  h4 Công nghê dẫn đầu
                  h1
                    | Lựa chọn hoàn hảo
                    br
                    | Cho Tương Lai
                  a.common_btn(href="/product/category")
                    | Xem sản phẩm
                    i.far.fa-arrow-right
                .phone_banner_visual
                  img.phone_banner_phone.phone_banner_phone_back(
                    alt="Dien thoai sanh dieu"
                    src="/client/assets/images/product_22.webp"
                    )
                  img.phone_banner_phone.phone_banner_phone_front(
                    alt="Dien thoai phong cach"
                    src="/client/assets/images/product_23.jpg"
                    )
            ul.phone_banner_dots
              li
                button.active(type="button" data-banner-dot aria-label="Slide 1" aria-current="true")
              li
                button(type="button" data-banner-dot aria-label="Slide 2" aria-current="false")
              li
                button(type="button" data-banner-dot aria-label="Slide 3" aria-current="false")
        .col-xl-4.col-lg-5
          .phone_banner_side.wow.fadeInRight
            .phone_banner_side_text
              h5 Chào mừng ngày hè
              a.common_btn(href=(newestProducts.length > 0 ? `/product/detail/${newestProducts[0].slug}` : "/product/category"))
                | Mua Ngay
                i.far.fa-arrow-right
            .phone_banner_side_visual
              img.side_phone.side_phone_left(
                alt="Dien thoai sale"
                src="/client/assets/images/product_22.webp"
                )
              img.side_phone.side_phone_right(
                alt="Dien thoai moi"
                src="/client/assets/images/product_24.webp"
                )

  section.mt_100
    .container
      .row.align-items-center
        .col-xl-8
          .section_heading_2.section_heading
            h3
              span Sản phẩm Đang giảm giá
        .col-xl-4.text-xl-end
          a.common_btn(href="/product/category?onSale=true") Xem tất cả
      .row.mt_25
        if saleProducts.length > 0
          each item in saleProducts
            .col-xxl-3.col-xl-4.col-md-6.wow.fadeInUp
              +product-item-2(item)
        else
          .col-12
            p.mb-0 Chưa có sản phẩm nào đang giảm giá.

  section.mt_100
    .container
      .row.align-items-center
        .col-xl-8
          .section_heading_2.section_heading
            h3
              span Sản phẩm Mới Nhất
        .col-xl-4.text-xl-end
          a.common_btn(href="/product/category") Xem tất cả
      .row.mt_25
        if newestProducts.length > 0
          each item in newestProducts
            .col-xxl-3.col-xl-4.col-md-6.wow.fadeInUp
              +product-item-2(item)
        else
          .col-12
            p.mb-0 Chưa có sản phẩm nào mới.

  section.blog_2.mt_100.mb_100
    .container
      .row.align-items-center
        .col-xl-8
          .section_heading_2.section_heading
            h3
              span Bài viết Mới nhất
        .col-xl-4.text-xl-end
          a.common_btn(href=(latestArticles.length > 0 ? `/article/detail/${latestArticles[0].slug}` : "#")) Xem bài viết
      .row.mt_25
        if latestArticles.length > 0
          each item in latestArticles
            .col-xl-4.col-md-6.wow.fadeInUp
              +blog-item(item)
        else
          .col-12
            p.mb-0 Chưa có bài viết nào mới.
